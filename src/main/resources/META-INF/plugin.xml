<idea-plugin>
    <id>com.papalugo.projectcolorbar</id>
    <name>Project Color Bar</name>
    <version>1.0.10</version>
    <vendor email="comin.claudinei@gmail.com" url="https://github.com/you/project-color-bar">Project Color Bar</vendor>

    <description><![CDATA[
        Color your IDE title bar and window borders per project for instant visual identification.<br><br>
        <b>Features:</b><br>
        <ul>
            <li>Assign a custom color to each project's title bar and borders</li>
            <li>Colors persist per project and restore on next open</li>
            <li>Access via <b>Tools → Set Project Color</b></li>
            <li>Works on Windows, macOS, and Linux</li>
        </ul>
    ]]></description>

    <!-- Compatible with IntelliJ 2024.1 (build 241) through 2026.3 (build 263) -->
    <idea-version since-build="241" until-build="263.*"/>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Stores color setting per project -->
        <projectService
            serviceInterface="com.papalugo.projectcolorbar.ProjectColorSettings"
            serviceImplementation="com.papalugo.projectcolorbar.ProjectColorSettings"/>
    </extensions>

    <applicationListeners>
        <!-- Aplica cor quando a janela ganha foco ou quando muda de projeto -->
        <listener class="com.papalugo.projectcolorbar.ProjectColorActivationListener"
                  topic="com.intellij.openapi.application.ApplicationActivationListener"/>
        <listener class="com.papalugo.projectcolorbar.ProjectColorProjectListener"
                  topic="com.intellij.openapi.project.ProjectManagerListener"/>
    </applicationListeners>

    <actions>
        <action id="com.papalugo.projectcolorbar.SetProjectColorAction"
                class="com.papalugo.projectcolorbar.SetProjectColorAction"
                text="Set Project Color..."
                description="Choose a color for this project's title bar and borders"
                icon="/icons/palette.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="com.papalugo.projectcolorbar.ClearProjectColorAction"
                class="com.papalugo.projectcolorbar.ClearProjectColorAction"
                text="Clear Project Color"
                description="Remove the custom color from this project">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
